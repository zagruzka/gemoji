{
  "name": "gemoji",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/games/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --filter @gemoji/server dev",
    "dev:web": "bun --filter @gemoji/web dev",
    "build": "bun --filter @gemoji/web build",
    "start": "bun --filter @gemoji/server start",
    "prod": "bun run build && bun run start",
    "test": "bun test",
    "db:seed": "bun --filter @gemoji/server db:seed",
    "typecheck": "bun --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}